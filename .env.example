# Copy this file to .env.local and fill in real keys when needed.

BACKEND_PORT=18081

ADMIN_USERNAME=admin
ADMIN_PASSWORD=nexusmind123

MYSQL_ROOT_PASSWORD=nexusmind-local
MYSQL_PASSWORD=nexusmind-local
MYSQL_HOST_PORT=13306
MYSQL_PORT=13306

REDIS_PASSWORD=nexusmind-local
REDIS_HOST_PORT=6379
REDIS_PORT=6379

ELASTICSEARCH_PASSWORD=nexusmind-local
ELASTICSEARCH_HOST_PORT=9200
ELASTICSEARCH_PORT=9200

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=nexusmind-local
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=nexusmind-local
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001
MINIO_API_PORT=19000

KAFKA_HOST_PORT=9092
KAFKA_CONTROLLER_HOST_PORT=9093
KAFKA_PORT=9092

KNOWLEDGE_GRAPH_ENABLED=true
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=nexusmind-local
NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=7687
NEO4J_URI=bolt://localhost:7687

JWT_SECRET_KEY=nexusmind-local-development-secret-key-change-before-production

DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

# 下载票据有效期，默认与原预签名链接一致（1 小时）。
FILE_DOWNLOAD_TICKET_TTL=1h

# Mail: use "tencent-ses" for personal Tencent Cloud accounts without SMTP access.
MAIL_PROVIDER=smtp
TENCENT_SES_SECRET_ID=
TENCENT_SES_SECRET_KEY=
TENCENT_SES_REGION=ap-hongkong
TENCENT_SES_FROM_ADDRESS=noreply@mail.example.com
TENCENT_SES_VERIFICATION_TEMPLATE_ID=0
TENCENT_SES_ORGANIZATION_APPLICATION_TEMPLATE_ID=0
TENCENT_SES_ORGANIZATION_RESULT_TEMPLATE_ID=0
TENCENT_SES_MEMBERSHIP_CHANGE_TEMPLATE_ID=0
TENCENT_SES_ROLE_CHANGE_TEMPLATE_ID=0
TENCENT_SES_ACCOUNT_STATUS_CHANGED_TEMPLATE_ID=0
TENCENT_SES_EMAIL_CHANGED_TEMPLATE_ID=0
TENCENT_SES_TEST_TEMPLATE_ID=0

MINERU_BASE_URL=http://localhost:18000
MINERU_PARSE_PATH=/file_parse
MINERU_BACKEND=hybrid-auto-engine
MINERU_PARSE_METHOD=auto
MINERU_OCR=false
MINERU_ENABLE_TABLE=false
MINERU_ENABLE_FORMULA=false
MINERU_API_HOST_PORT=18000
MINERU_MODEL_SOURCE=local
MINERU_MODEL_DOWNLOAD_SOURCE=huggingface
MINERU_MODEL_DOWNLOAD_TYPE=pipeline
MINERU_SKIP_MODEL_DOWNLOAD=false
# Only used with backend/docs/docker-compose.mineru-gpu.yaml.
MINERU_GPU_DEVICE_IDS=0
# If model download fails inside the MinerU container, use host.docker.internal instead of 127.0.0.1.
# Example: MINERU_HTTP_PROXY=http://host.docker.internal:7890
MINERU_HTTP_PROXY=
MINERU_HTTPS_PROXY=
MINERU_NO_PROXY=localhost,127.0.0.1

LANGFUSE_TRACING_ENABLED=false
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=dev
LANGFUSE_CAPTURE_CONTENT=false

# 检索融合与重排（可选；rerank 模型在「模型配置」页面以 RERANK 类型配置，无需环境变量）
# rrf=双路召回+RRF融合（默认）；legacy=旧版单请求融合回退
AI_RETRIEVAL_FUSION_MODE=rrf
# rerank 开关（无可用 RERANK 模型配置时自动跳过）
AI_RETRIEVAL_RERANK_ENABLED=true
# rerank 超时毫秒数，超时后保持 RRF 融合排序
AI_RETRIEVAL_RERANK_TIMEOUT_MS=8000
